# 이 파일을 복사해서 .env로 저장하고 실제 값을 채우세요.
# cp .env.example .env

# PostgreSQL 접속 정보
DB_URL=jdbc:postgresql://<host>:<port>/<db>
DB_USERNAME=
DB_PASSWORD=

# Google Cloud Console > OAuth 클라이언트 (승인된 리디렉션 URI: http://localhost:8080/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 선택: 리버스 프록시 뒤에 있으면 실제 외부 주소로 고정해야 함 (예: https://example.com/login/oauth2/code/google)
# 비워두면 요청의 호스트를 기준으로 자동 계산 (로컬 개발용)
GOOGLE_OAUTH_REDIRECT_URI=

# 임의의 32바이트(글자) 이상 랜덤 문자열
JWT_SECRET=

# 프론트엔드가 로그인 완료 후 돌아갈 주소 (Vite 기본 포트)
FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback

# Google AI Studio에서 발급한 Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 선택: 비워두면 gemini-3.5-flash-lite 사용
GEMINI_MODEL=

# Google Cloud Console에서 "Places API (New)" 활성화 후 발급한 키
GOOGLE_PLACES_API_KEY=
